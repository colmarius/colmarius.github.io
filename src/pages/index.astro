---
import AboutMeSummary from '@components/index/AboutMeSummary.astro';
import HelloMessage from '@components/index/HelloMessage.astro';
import ReachOutMessage from '@components/index/ReachOutMessage.astro';
import Layout from '@layouts/Layout.astro';
---

<Layout title="Marius Colacioiu – Engineering Leader and Entrepreneur">
  <div class="space-y-32 sm:space-y-40">
    <HelloMessage />
    <AboutMeSummary />
    <section class="max-w-3xl mx-auto" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="mb-6 text-sm font-medium uppercase tracking-wider text-gray-500">
        Projects I maintain
      </h2>
      <div class="border-y border-gray-200 divide-y divide-gray-200">
        <a
          href="https://dot-agents.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start justify-between gap-8 py-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2"
        >
          <div>
            <h3 class="text-xl font-medium text-gray-900 transition-colors duration-200 group-hover:text-indigo-600">
              dot-agents
            </h3>
            <p class="mt-2 font-light leading-relaxed text-gray-600">
              Make AI coding work survive the next thread with durable, repo-local context.
            </p>
          </div>
          <span aria-hidden="true" class="mt-1 text-indigo-700 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
          <span class="sr-only">Opens in a new tab</span>
        </a>
        <a
          href="https://with-agents.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start justify-between gap-8 py-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-600/50 focus-visible:ring-offset-2"
        >
          <div>
            <h3 class="text-xl font-medium text-gray-900 transition-colors duration-200 group-hover:text-indigo-600">
              With Agents
            </h3>
            <p class="mt-2 font-light leading-relaxed text-gray-600">
              Practical, source-backed field guides for working effectively with coding agents.
            </p>
          </div>
          <span aria-hidden="true" class="mt-1 text-indigo-700 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5">↗</span>
          <span class="sr-only">Opens in a new tab</span>
        </a>
      </div>
    </section>
    <ReachOutMessage />
  </div>
</Layout>
