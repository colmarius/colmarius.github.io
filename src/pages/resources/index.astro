---
import ResourceCard from '../../components/resources/ResourceCard';
import books from '../../data/resources/books.json';
import newsletters from '../../data/resources/newsletters.json';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Marius Colacioiu – Resources">
  <div class="max-w-5xl mx-auto">
    <h1 class="text-4xl md:text-5xl font-light mb-4 text-gray-900">
      Resources
    </h1>
    <p class="text-xl text-gray-600 mb-16 font-light leading-relaxed">
      A curated collection of learning resources, newsletters, and books that inspire and inform my work.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <ResourceCard
        href="https://with-agents.dev"
        title="With Agents"
        description="A source-backed field guide to practical coding-agent workflows, articles, and resources."
        iconType="agent"
        external
      />
      <ResourceCard
        href="/resources/newsletters"
        title="Newsletters"
        description="Weekly insights on tech, AI, and software engineering from my favorite sources."
        count={newsletters.length}
        iconType="newsletter"
      />
      <ResourceCard
        href="/resources/books"
        title="Books"
        description="Books that shaped my thinking on technology, business, and decision-making."
        count={books.length}
        iconType="book"
      />
    </div>
  </div>
</Layout>
